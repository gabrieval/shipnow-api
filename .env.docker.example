# ---------------------------------------------------------------------------
# Variables para ejecutar la API en Docker Compose.
# Copiar como `.env.docker`. NO se versiona.
#
# MONGODB_URI no hace falta aca: docker-compose.yml la fija apuntando al
# servicio `mongo` de la red interna.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=8080

LOG_LEVEL=info
API_PUBLIC_URL=http://localhost:8080

# En produccion quedan apagados por defecto. Ponerlos en true para poder probar
# el modulo de mocks dentro del contenedor.
ENABLE_INTERNAL_ENDPOINTS=false
ENABLE_DOCS=true

DEFAULT_PAGE_SIZE=10
BCRYPT_SALT_ROUNDS=10
