# ---------------------------------------------------------------------------
# ShipNow API - variables de entorno
# Copiar este archivo como `.env` y completar con valores reales.
# El archivo `.env` NO se versiona (ver .gitignore).
# ---------------------------------------------------------------------------

# Entorno de ejecucion. Valores admitidos: development | production | test
NODE_ENV=

# Puerto HTTP donde escucha la API (entero entre 1 y 65535)
PORT=

# String de conexion a MongoDB. Debe empezar con mongodb:// o mongodb+srv://
MONGODB_URI=

# --- Opcionales (tienen valor por defecto en src/config/env.config.js) ---

# Cantidad de documentos por pagina cuando el cliente no envia ?limit
DEFAULT_PAGE_SIZE=

# Rondas de hashing de bcrypt para las contrasenas de usuarios
BCRYPT_SALT_ROUNDS=
