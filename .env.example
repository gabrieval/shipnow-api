# ---------------------------------------------------------------------------
# ShipNow API - variables de entorno
# Copiar este archivo como `.env` y completar con valores reales.
# El archivo `.env` NO se versiona (ver .gitignore).
#
# Para el entorno de testing existe un archivo aparte: `.env.test.example`.
# ---------------------------------------------------------------------------

# --- Criticas: si falta alguna, la app NO arranca --------------------------

# Entorno de ejecucion. Valores admitidos: development | production | test
NODE_ENV=development

# Puerto HTTP donde escucha la API (entero entre 1 y 65535)
PORT=8080

# String de conexion a MongoDB. Debe empezar con mongodb:// o mongodb+srv://
# En Docker Compose el host es el nombre del servicio: mongodb://mongo:27017/shipnow
MONGODB_URI=mongodb://127.0.0.1:27017/shipnow

# --- Opcionales: tienen valor por defecto en src/config/env.config.js ------

# Cantidad de documentos por pagina cuando el cliente no envia ?limit
DEFAULT_PAGE_SIZE=10

# Rondas de hashing de bcrypt para las contrasenas de usuarios (entre 4 y 15)
BCRYPT_SALT_ROUNDS=10

# Nivel minimo de log: fatal | error | warning | info | http | debug
# Por defecto: debug en development, info en production, error en test
LOG_LEVEL=debug

# URL publica de la API, la que declara Swagger como servidor.
# Detras de un proxy o en un contenedor, "localhost" no es la direccion real.
API_PUBLIC_URL=http://localhost:8080

# Endpoints internos (/api/mocks y /api/logger-test): true | false
# Por defecto quedan APAGADOS en produccion, porque permiten escribir y borrar
# datos en masa. Encendidos en development y testing.
ENABLE_INTERNAL_ENDPOINTS=true

# Documentacion Swagger en /api/docs: true | false
# Encendida por defecto en todos los entornos; apagar si el despliegue es privado.
ENABLE_DOCS=true

# --- Servicios externos ----------------------------------------------------
# Este proyecto todavia no consume APIs de terceros ni emite tokens, asi que no
# hay claves ni secretos que configurar. Cuando se incorpore autenticacion, el
# secreto de JWT va aca (JWT_SECRET) y NUNCA escrito en el codigo.
