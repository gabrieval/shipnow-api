{
  "name": "shipnow-api",
  "version": "1.0.0",
  "description": "API de ShipNow refactorizada en arquitectura por capas (Controller - Service - Repository)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "cross-env NODE_ENV=test mocha",
    "test:db": "cross-env NODE_ENV=test USE_REAL_DB=true mocha",
    "test:watch": "cross-env NODE_ENV=test mocha --watch"
  },
  "keywords": [
    "express",
    "mongoose",
    "layered-architecture",
    "coderhouse"
  ],
  "author": "Gabriela Valenzuela",
  "license": "ISC",
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.5.0",
    "multer": "^2.2.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "cross-env": "^10.1.0",
    "mocha": "^11.8.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.1.0"
  }
}
