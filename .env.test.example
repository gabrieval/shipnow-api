# ---------------------------------------------------------------------------
# ShipNow API - variables de entorno del ENTORNO DE TESTING
#
# Copiar como `.env.test`. Lo carga automaticamente `src/config/env.config.js`
# cuando NODE_ENV=test, que es lo que fija el script `npm test`.
#
# IMPORTANTE: la base tiene que ser distinta a la de desarrollo. Los tests
# borran las colecciones despues de cada grupo.
# ---------------------------------------------------------------------------

NODE_ENV=test

# Puerto. Los tests no abren el puerto (Supertest levanta uno efimero), pero la
# validacion de entorno lo exige igual.
PORT=8081

# Base de datos de testing. Si se deja el valor por defecto, `npm test` levanta
# una instancia de MongoDB EN MEMORIA y esta variable no se usa: no hace falta
# tener MongoDB instalado para correr los tests.
# Para correr contra una base real, poner aca la URI y usar `npm run test:db`.
MONGODB_URI=mongodb://127.0.0.1:27017/shipnow_test

DEFAULT_PAGE_SIZE=10

# Bajo a proposito: bcrypt con 10 rondas hace los tests innecesariamente lentos.
BCRYPT_SALT_ROUNDS=4
